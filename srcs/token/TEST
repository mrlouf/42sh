# Basic tokenization
echo hello world
ls -l /tmp

# Simple quotes
echo "hello world"
echo 'hello world'

# Quotes with spaces
echo "hello    world"
echo 'hello    world'

# Mixed quotes
echo foo"bar baz"qux
echo 'foo"bar' baz'qux'

# Quote combinations
echo "a   b" c   d
echo a" b "c
echo "a b"c'd e'

# Operators
ls > out.txt
cat < in.txt
echo hello | grep lo

# Redirections
echo hello >file 2>&1
echo "hello" > "file name.txt"

# Escaped quotes (critical test cases)
echo "He said: \"hello\""
echo 'can'\''t do it'
echo "test\"quote"
echo "backslash: \\"

# Edge cases
echo ""
echo ''
echo foo""bar
echo foo''bar

# Unclosed quotes (should trigger continuation)
echo "unclosed
echo 'unclosed

# Complex cases
echo "Mix 'single' and \"double\""
echo 'It'\''s '\''working'\'''